[
    {
        "name": "air00",
        "tilte": "Découper une chaîne de caractères",
        "tests": [
            {
                "input": ["Bonjour les gars"," "],
                "expected": ["Bonjour", "les", "gars"]
            },
            {
                "input": ["Bonjour,les,gars", ","],
                "expected": ["Bonjour", "les", "gars"]
            },
            {
                "input": ["Bonjour-les-gars", "-"],
                "expected": ["Bonjour", "les", "gars"]
            }
        ]
    },
        {
        "name": "air01",
        "tilte": "Découper une chaîne avec un séparateur personnalisé",
        "tests": [
            {
                "input":["Crevette magique dans la mer des étoiles","la"],
                "expected": ["Crevette magique dans","mer des étoiles"]
            },
            {
                "input":["Crevette magique dans la mer des étoiles","kapoué"],
                "expected": ["Crevette magique dans la mer des étoiles"]
            },
            {
                "input": ["Crevette magique dans la mer des étoiles"," "],
                "expected": ["Crevette","magique","dans", "la", "mer", "des", "étoiles"]
            }
        ]
    },
        {
        "name": "air02",
        "tilte": "Concaténer une liste de chaînes avec un séparateur",        
        "tests": [
            {
                "input":["je", "test", "des", "trucs", " "],
                "expected": ["je test des trucs"]
            },
            {
                "input":["je", "test", "des", "trucs", "\n"],
                "expected": ["je", "test", "des", "trucs"]
            },
            {
                "input":["je", "test", "des", "trucs", "-"],
                "expected": ["je-test-des-trucs"]
            }
        ]
    },
        {
        "name": "air03",
        "tilte": "Trouver l'élément sans paire dans une liste",        
        "tests": [
            {
                "input":["1","2", "3", "4", "5", "4", "3", "2", "1" ],
                "expected": ["5"]
            },
            {
                "input":["bonjour", "monsieur","bonjour"],
                "expected": ["monsieur"]
            },
            {
                "input":["-", "test", "des", "choses", "test", "-"],
                "expected": ["des choses"]
            }
        ]
    },
        {
        "name": "air04",
        "tilte": "Supprimer les caractères identiques adjacents",        
        "tests": [
            {
                "input":["Hello milady,   bien ou quoi ??"],
                "expected": ["Helo milady, bien ou quoi ?"]
            },
            {
                "input":["boonjjjourrrr"],
                "expected": ["bonjour"]
            },
            {
                "input":["------"],
                "expected": ["-"]
            }
        ]
    },
        {
        "name": "air05",
        "tilte": "Opérations sur une liste d'entiers",        
        "tests": [
            {
                "input":["1", "2", " 3", "4", "5", "+2"],
                "expected": ["3 4 5 6 7"]
            },
            {
                "input":["5", "2", "1", "4", "5", "-2"],
                "expected": ["3 0 -1 2 3"]
            },
            {
                "input":["5", "2", "1", "4", "5", "+0"],
                "expected": ["5 2 1 4 5"]
            }
        ]
    },
        {
        "name": "air06",
        "tilte": " Filtrer un tableau : garder les éléments qui NE contiennent PAS la sous-chaîne (insensible à la casse)",        
        "tests": [
            {
                "input":["Michel", "Albert", "Thérèse", "Benoit", "t"],
                "expected": ["Michel"]
            },
            {
                "input":["Michel", "Albert", "Thérèse", "Benoit", "a"],
                "expected": ["Michel, Thérèse, Benoit"]
            },
            {
                "input":["5", "2", "1", "4", "5", "5"],
                "expected": ["2, 1, 4"]
            }
        ]
    }
]