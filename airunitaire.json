[
    {
        "name": "air00",
        "tilte": "Découper une chaîne de caractères",
        "tests": [
            {
                "input": ["Bonjour les gars"," "],
                "expected": ["Bonjour", "les", "gars"]
            },
            {
                "input": ["Bonjour,les,gars", ","],
                "expected": ["Bonjour", "les", "gars"]
            },
            {
                "input": ["Bonjour-les-gars", "-"],
                "expected": ["Bonjour", "les", "gars"]
            }
        ]
    },
        {
        "name": "air01",
        "tilte": "Découper une chaîne avec un séparateur personnalisé",
        "tests": [
            {
                "input":["Crevette magique dans la mer des étoiles","la"],
                "expected": ["Crevette magique dans","mer des étoiles"]
            },
            {
                "input":["Crevette magique dans la mer des étoiles","kapoué"],
                "expected": ["Crevette magique dans la mer des étoiles"]
            },
            {
                "input": ["Crevette magique dans la mer des étoiles"," "],
                "expected": ["Crevette","magique","dans", "la", "mer", "des", "étoiles"]
            }
        ]
    },
        {
        "name": "air02",
        "tilte": "Concaténer une liste de chaînes avec un séparateur",        
        "tests": [
            {
                "input":["je", "test", "des", "trucs", " "],
                "expected": ["je test des trucs"]
            },
            {
                "input":["je", "test", "des", "trucs", "\n"],
                "expected": ["je", "test", "des", "trucs"]
            },
            {
                "input":["je", "test", "des", "trucs", "-"],
                "expected": ["je-test-des-trucs"]
            }
        ]
    },
        {
        "name": "air03",
        "tilte": "Trouver l'élément sans paire dans une liste",        
        "tests": [
            {
                "input":["1","2", "3", "4", "5", "4", "3", "2", "1" ],
                "expected": ["5"]
            },
            {
                "input":["bonjour", "monsieur","bonjour"],
                "expected": ["monsieur"]
            },
            {
                "input":["-", "test", "des", "choses", "test", "-"],
                "expected": ["des choses"]
            }
        ]
    },
        {
        "name": "air04",
        "tilte": "Supprimer les caractères identiques adjacents",        
        "tests": [
            {
                "input":["Hello milady,   bien ou quoi ??"],
                "expected": ["Helo milady, bien ou quoi ?"]
            },
            {
                "input":["boonjjjourrrr"],
                "expected": ["bonjour"]
            },
            {
                "input":["------"],
                "expected": ["-"]
            }
        ]
    },
        {
        "name": "air05",
        "tilte": "Opérations sur une liste d'entiers",        
        "tests": [
            {
                "input":["1", "2", " 3", "4", "5", "+2"],
                "expected": ["3 4 5 6 7"]
            },
            {
                "input":["5", "2", "1", "4", "5", "-2"],
                "expected": ["3 0 -1 2 3"]
            },
            {
                "input":["5", "2", "1", "4", "5", "+0"],
                "expected": ["5 2 1 4 5"]
            }
        ]
    },
        {
        "name": "air06",
        "tilte": " Filtrer un tableau : garder les éléments qui NE contiennent PAS la sous-chaîne (insensible à la casse)",        
        "tests": [
            {
                "input":["Michel", "Albert", "Thérèse", "Benoit", "t"],
                "expected": ["Michel"]
            },
            {
                "input":["Michel", "Albert", "Thérèse", "Benoit", "a"],
                "expected": ["Michel, Thérèse, Benoit"]
            },
            {
                "input":["5", "2", "1", "4", "5", "5"],
                "expected": ["2, 1, 4"]
            }
        ]
    },
        {
        "name": "air07",
        "tilte": "Insertion triée dans une liste d'entiers ",        
        "tests": [
            {
                "input":["1","3","4","2"],
                "expected": ["1 2 3 4"]
            },
            {
                "input":["10", "20", "30", "40", "50", "60","70", "90","33"],
                "expected": ["10 20 30 33 40 50 60 70 90"]
            },
            {
                "input":[ "20", "30", "40", "50", "60","70", "90","10"],
                "expected": ["10 20 30 40 50 60 70 90"]
            }
        ]
    },
        {
        "name": "air09",
        "tilte": "Fusion de deux listes triées",        
        "tests": [
            {
                "input":["Michel","Albert","Thérèse","Benoit"],
                "expected": ["Albert, Thérèse, Benoit, Michel"]
            },
            {
                "input":["Gauche","Centre","Droite"],
                "expected": ["Centre, Droite, Gauche"]
            },
            {
                "input":["Ka", "y", "aK"],
                "expected": ["y, aK, Ka"]
            }
        ]
    },
        {
        "name": "air10",
        "tilte": "Affichage du contenu d'un fichier",        
        "tests": [
            {
                "input":["a.txt"],
                "expected": ["Je danse le mia"]
            },
            {
                "input":["a1.txt"],
                "expected": ["Je danse","le mia"]
            },
            {
                "input":["a2.txt"],
                "expected": []
            }
        ]
    },
        {
        "name": "air11",
        "tilte": "Cortex",        
        "tests": [
            {
                "input":["0","5"],
                "expected": [".    0", ".   000", ".  00000", ". 0000000", ".000000000"]
            },
            {
                "input":["*","5"],
                "expected": [".    *", ".   ***", ".  *****", ". *******", ".*********"]
            },
            {
                "input":["Z","5"],
                "expected": [".    Z", ".   ZZZ", ".  ZZZZZ", ". ZZZZZZZ", ".ZZZZZZZZZ"]
            }
        ]
    }
]
